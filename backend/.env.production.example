# =============================================================
# JŌNETSU backend - production environment template
# This file is a template only and must never be committed with real secrets.
# Copy it to `.env.production` and fill in the real values for deployment.
# =============================================================

NODE_ENV=production
PORT=3000

# Database
DATABASE_HOST=prod-db-host
DATABASE_PORT=5432
DATABASE_USER=jonetsu_app
DATABASE_PASSWORD=change-me-strong-password
DATABASE_NAME=jonetsu_db

# JWT / Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=3600s
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Admin SDK
FIREBASE_PROJECT_ID=prod-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@prod-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_REAL_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=prod-project-id.appspot.com

# CORS / Frontend
FRONTEND_URL=https://your-frontend-domain.com
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://admin.your-frontend-domain.com

# OpenAI
OPENAI_API_KEY=replace-with-real-openai-key
OPENAI_MODEL=gpt-4o-mini

# FCM
FCM_PROJECT_ID=prod-project-id
FCM_CLIENT_EMAIL=fcm@prod-project-id.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_REAL_KEY\n-----END PRIVATE KEY-----\n"

# Cloud Storage
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=replace-with-real-access-key
AWS_SECRET_ACCESS_KEY=replace-with-real-secret
AWS_S3_BUCKET=jonetsu-prod-media
AWS_S3_ENDPOINT=

# Admin bootstrap
ADMIN_EMAIL=admin@your-domain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password

# Redis
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-real-redis-password

# App security
APP_SECRET=replace-with-random-app-secret
SESSION_SECRET=replace-with-random-session-secret

# Observability
LOG_LEVEL=info
SENTRY_DSN=
ANALYTICS_ENABLED=true

# SMTP / Mail (if enabled later)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com
