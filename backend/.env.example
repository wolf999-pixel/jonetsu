# =============================================================
# JŌNETSU backend - environment template
# Copy this file to `.env` and replace placeholders before running.
# Never commit a real `.env` file to version control.
# =============================================================

NODE_ENV=development
PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=jonetsu_db

# JWT / Auth
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=3600s
JWT_REFRESH_SECRET=replace-me-with-a-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Frontend / CORS
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001,https://app.your-domain.com

# OpenAI
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini

# FCM / Notifications
FCM_PROJECT_ID=your-project-id
FCM_CLIENT_EMAIL=fcm@your-project-id.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional cloud storage
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_BUCKET=jonetsu-media
AWS_S3_ENDPOINT=

# Admin bootstrap account
ADMIN_EMAIL=admin@your-domain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Redis cache (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Application secrets
APP_SECRET=replace-me-with-a-random-secret
SESSION_SECRET=replace-me-with-a-random-secret

# Logging and observability
LOG_LEVEL=debug
SENTRY_DSN=
ANALYTICS_ENABLED=true

# Optional: mail provider if used later
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com
